# Konfigurasi provider non-rahasia (spec §13.2.8, D-017). Nama variabel persis `provider.RouterConfig`.
# STATUS: nilai di bawah adalah DEFAULT spec §13.2.8 (sama dengan envDefault di kode), BUKAN hasil
# benchmark M9. `deploy/config/provider.env` (M9 Task 22) belum ada dan pemilihan vendor aktif di
# produksi diputuskan manual oleh pemilik produk. Overlay staging/prod menandai ConfigMap dengan
# anotasi kotoki.io/provider-selection=REPLACE_PRODUCT_OWNER_DECISION; `pins-check --prod` GAGAL
# selama anotasi itu masih placeholder. Tidak ada kunci API di sini (itu milik ExternalSecret).

# Sakelar vendor: STT tepat satu true; LLM tepat satu true; TTS minimal satu true; embedding wajib true.
OPENAI_STT_ENABLED=true
ELEVENLABS_STT_ENABLED=false
CARTESIA_STT_ENABLED=false
OPENAI_LLM_ENABLED=true
DEEPSEEK_LLM_ENABLED=false
ELEVENLABS_TTS_ENABLED=true
CARTESIA_TTS_ENABLED=true
OPENAI_EMBEDDING_ENABLED=true

# Model per vendor/kapabilitas (hanya vendor aktif yang dibaca). Placeholder sampai benchmark (Bab 8 §8.10).
OPENAI_STT_MODEL=gpt-live-transcribe
ELEVENLABS_STT_MODEL=scribe_v2_realtime
CARTESIA_STT_MODEL=ink-2
OPENAI_LLM_MODEL=gpt-4.1
DEEPSEEK_LLM_MODEL=deepseek-flash
OPENAI_EVALUATION_MODEL=gpt-4.1
DEEPSEEK_EVALUATION_MODEL=deepseek-v4-pro
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MAX_OUTPUT_TOKENS=300
LLM_TEMPERATURE=0.8
DEEPSEEK_LLM_THINKING=disabled
DEEPSEEK_EVALUATION_THINKING=disabled
# ROLLING_SUMMARY_LLM_MODEL sengaja tidak diset: default = model LLM vendor aktif.

# Endpoint vendor (nilai default spec §13.2.8; verifikasi terhadap dokumentasi resmi saat MANUAL GATE).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WS_BASE_URL=wss://api.openai.com/v1/realtime
DEEPSEEK_BASE_URL=https://api.deepseek.com
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_WS_BASE_URL=wss://api.elevenlabs.io
CARTESIA_BASE_URL=https://api.cartesia.ai
CARTESIA_WS_BASE_URL=wss://api.cartesia.ai
CARTESIA_VERSION=2026-08-14

# Konkurensi per pod per (vendor, kapabilitas) (spec §8.5.6): 10 kombinasi yang didukung.
PROVIDER_CONCURRENCY_OPENAI_STT=125
PROVIDER_CONCURRENCY_ELEVENLABS_STT=125
PROVIDER_CONCURRENCY_CARTESIA_STT=125
PROVIDER_CONCURRENCY_OPENAI_LLM=60
PROVIDER_CONCURRENCY_DEEPSEEK_LLM=60
PROVIDER_CONCURRENCY_ELEVENLABS_TTS=80
PROVIDER_CONCURRENCY_CARTESIA_TTS=80
PROVIDER_CONCURRENCY_OPENAI_EVALUATION=8
PROVIDER_CONCURRENCY_DEEPSEEK_EVALUATION=8
PROVIDER_CONCURRENCY_OPENAI_EMBEDDING=16
