{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scores",
    "signals",
    "summary",
    "strengths",
    "focus_areas",
    "recommendations",
    "findings"
  ],
  "properties": {
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GRAMMAR",
        "VOCABULARY",
        "FLUENCY",
        "NATURALNESS",
        "TASK_ACHIEVEMENT"
      ],
      "properties": {
        "GRAMMAR": {
          "$ref": "#/$defs/dimensionScore"
        },
        "VOCABULARY": {
          "$ref": "#/$defs/dimensionScore"
        },
        "FLUENCY": {
          "$ref": "#/$defs/dimensionScore"
        },
        "NATURALNESS": {
          "$ref": "#/$defs/dimensionScore"
        },
        "TASK_ACHIEVEMENT": {
          "$ref": "#/$defs/dimensionScore"
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "LISTENING_RESPONSE",
        "INTERACTION_COMPLEXITY"
      ],
      "properties": {
        "LISTENING_RESPONSE": {
          "$ref": "#/$defs/signal"
        },
        "INTERACTION_COMPLEXITY": {
          "$ref": "#/$defs/signal"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "strengths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 200
      }
    },
    "focus_areas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 200
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "dimensionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "confidence",
        "comment"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "comment": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "confidence"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "detail",
        "example_ja"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "detail": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "example_ja": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "finding_type",
        "severity",
        "turn_seq",
        "original",
        "corrected",
        "explanation",
        "pattern_key",
        "confidence"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "GRAMMAR",
            "VOCABULARY",
            "FLUENCY",
            "NATURALNESS",
            "TASK_ACHIEVEMENT"
          ]
        },
        "finding_type": {
          "enum": [
            "PARTICLE_ERROR",
            "CONJUGATION_ERROR",
            "TENSE_ASPECT_ERROR",
            "SENTENCE_STRUCTURE_ERROR",
            "WORD_CHOICE_ERROR",
            "NON_JAPANESE_WORD",
            "COLLOCATION_ERROR",
            "POLITENESS_MISMATCH",
            "UNNATURAL_EXPRESSION",
            "EXCESSIVE_FILLER",
            "FRAGMENTED_UTTERANCE",
            "OVERLY_SHORT_RESPONSE",
            "OFF_TOPIC_RESPONSE",
            "MISUNDERSTOOD_PROMPT",
            "OBJECTIVE_NOT_MET",
            "STRENGTH"
          ]
        },
        "severity": {
          "enum": [
            "INFO",
            "MINOR",
            "MAJOR"
          ]
        },
        "turn_seq": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "original": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "corrected": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "explanation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400
        },
        "pattern_key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9_.]{3,64}$"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
