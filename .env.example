# ---- Umum ----
APP_ENV=local
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_TRANSCRIPTS=false
PPROF_ENABLED=true

# ---- Origin (frontend dev / kotoki-cli) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
WS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Data stores (docker-compose) ----
DB_URL=postgres://kotoki:kotoki@localhost:5432/kotoki?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://kotoki:kotoki@localhost:5672/

# ---- Auth & akun ----
AUTH_JWT_SECRET=bG9jYWwtZGV2LW9ubHktMDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AUTH_REFRESH_COOKIE_SECURE=false
INITIAL_BALANCE_SECONDS=3600
PRIVACY_POLICY_VERSION=2026-10-01

# Konten & sesi (spec 6.5, 5.9.4)
CONTENT_CACHE_TTL_SECONDS=30
RETENTION_TRANSCRIPT_DAYS=180
MAIL_MODE=log
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password

# ---- Realtime ----
WS_ALLOW_EMPTY_ORIGIN=true
# Listener cmd/realtime: HTTP_ADDR=:8081 (WebSocket), OPS_ADDR=:9091 (/healthz /readyz /metrics) bila tidak diisi;
# jangan diset di sini karena .env yang sama dibaca cmd/api (HTTP_ADDR :8080, OPS_ADDR :9090).
# REALTIME_POD_ID=            # default: hostname
# REALTIME_READY_MAX_SESSIONS=95    # /readyz 503 mulai nilai ini
# REALTIME_MAX_SESSIONS=100         # session.start baru ditolak 4503
# REALTIME_HARD_MAX_SESSIONS=120    # upgrade HTTP 503 sebelum ticket dikonsumsi
# TRUSTED_PROXY_CIDRS=10.0.0.0/8    # proxy tepercaya untuk subjek ws_connect_ip (X-Forwarded-For)

# ---- Provider (nama env Bab 8 §8.5.1, §8.9; sakelar vendor Bab 13 §13.2.8) ----
PROVIDER_MODE=fake
FAKE_PRIMARY_STT_LATENCY_MS=250
FAKE_PRIMARY_LLM_LATENCY_MS=500
FAKE_LLM_TOKEN_INTERVAL_MS=30
FAKE_PRIMARY_TTS_LATENCY_MS=300
# Fixture STT 16 kHz turunan testdata/audio/synth (`make fixtures16k`; kosongkan untuk mode energy)
FAKE_STT_FIXTURE_DIR=out/fixtures16k

# Isi hanya bila PROVIDER_MODE=real (jangan commit nilai asli). Default model = placeholder Bab 8 §8.5.1:
# API key per vendor (wajib bila ada kapabilitas vendor itu yang enabled):
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ELEVENLABS_API_KEY=
# CARTESIA_API_KEY=
# CARTESIA_BASE_URL=
# CARTESIA_VERSION=
# Sakelar vendor (Bab 13 §13.2.8): STT tepat satu true; LLM tepat satu true; TTS minimal satu true.
# OPENAI_STT_ENABLED=true
# ELEVENLABS_STT_ENABLED=false
# CARTESIA_STT_ENABLED=false
# OPENAI_LLM_ENABLED=true
# DEEPSEEK_LLM_ENABLED=false
# ELEVENLABS_TTS_ENABLED=true
# CARTESIA_TTS_ENABLED=true
# Model per vendor/kapabilitas (kosong = default placeholder Bab 8 §8.5.1):
# OPENAI_STT_MODEL=
# ELEVENLABS_STT_MODEL=
# CARTESIA_STT_MODEL=
# OPENAI_LLM_MODEL=
# DEEPSEEK_LLM_MODEL=
# OPENAI_EVALUATION_MODEL=
# DEEPSEEK_EVALUATION_MODEL=
# OPENAI_EMBEDDING_MODEL=
# OPENAI_EMBEDDING_ENABLED=true          # wajib true; OPENAI_API_KEY selalu wajib di mode real (embedding)
# LLM_MAX_OUTPUT_TOKENS=300
# LLM_TEMPERATURE=0.8

# ---- Observability (aktifkan bersama `make up-obs`) ----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---- realtime tuning (spec 7.2; values are the defaults) ----
WS_HANDSHAKE_TIMEOUT=10s
SESSION_START_TIMEOUT=10s
WS_PING_INTERVAL=15s
WS_IDLE_TIMEOUT=45s
WS_MAX_JSON_BYTES=16384
WS_MAX_BINARY_BYTES=4096
WS_BINARY_RATE=100
WS_BINARY_BURST=200
WS_JSON_RATE=20
WS_JSON_BURST=40
WS_OUTBOUND_QUEUE=256
WS_WRITE_TIMEOUT=5s
VAD_MODE=2
VAD_SPEECH_START_MS=200
VAD_SPEECH_START_WINDOW_MS=300
VAD_SPEECH_END_MS=300
TURN_SILENCE_DEFAULT_MS=800
TURN_SILENCE_FILLER_MS=1400
TURN_SILENCE_COMPLETE_MS=500
TURN_SILENCE_FILLER_ONLY_MS=2000
TURN_MAX_UTTERANCE_MS=45000
TURN_FILLER_SUFFIXES=えっと,ええと,あの,その,なんか,まあ,て,で,けど,が,から,し,とか,って
TURN_COMPLETION_SUFFIXES=。,？,?,か,ね,よ,です,ます,ました,でした,ません,ください
BARGEIN_VAD_MS=300
BARGEIN_WINDOW_MS=400
BARGEIN_MIN_PARTIAL_CHARS=2
AUDIO_MAX_LEAD_MS=400
PLAYBACK_FINISH_GRACE_MS=1500
OPUS_BITRATE=32000
OPUS_COMPLEXITY=5
RECONNECT_WINDOW=30s
SESSION_WARNING_OFFSETS=60s,10s
SESSION_EXPIRY_GRACE=10s
BALANCE_TICK_INTERVAL=10s
REPLAY_MAXLEN=500
REPLAY_TTL=120s
OWNER_TTL=15s
OWNER_REFRESH_INTERVAL=5s
HEARTBEAT_INTERVAL=5s
HEARTBEAT_TTL=60s
CONTEXT_RECENT_TURNS=8
CONTEXT_RECENT_TURNS_MAX=12
ROLLING_SUMMARY_TRIGGER_TURNS=4
ROLLING_SUMMARY_TIMEOUT=10s
MAX_CONSECUTIVE_FAILED_TURNS=3
DRAIN_SAFEPOINT_TIMEOUT=20s
DRAIN_FLUSH_TIMEOUT=5s

# ---- kotoki-cli ----
KOTOKI_CLI_API_URL=http://localhost:8080
KOTOKI_CLI_WS_URL=ws://localhost:8081/api/v1/realtime
KOTOKI_CLI_ORIGIN=http://localhost:3000
